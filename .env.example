# Database Configuration
DATABASE_URL=sqlite:dnd_scheduler.db

# Admin Configuration
# SECURITY: Change these before deploying. Password must be 12+ chars, upper+lower+digit+special.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_Pass1!
# SECURITY: Use a long random string (e.g. `openssl rand -hex 32`)
ADMIN_TOKEN=CHANGE_ME_use_openssl_rand_hex_32

# Session / Cookie Security
# SECURITY: Generate with `openssl rand -hex 64`
SESSION_SECRET=CHANGE_ME_use_openssl_rand_hex_64
# Set to false only for local HTTP development (http://localhost)
COOKIE_SECURE=true

# Email Configuration (SMTP)
# Set MOCK_EMAIL=true to disable real email sending (useful for testing)
MOCK_EMAIL=false
# Use your email provider's SMTP settings.
# Examples:
# Gmail: smtp.gmail.com, 587, your_email@gmail.com, your_app_password
# SendGrid: smtp.sendgrid.net, 587, apikey, your_api_key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM_EMAIL=noreply@dndscheduler.com

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token

# Authelia SSO Configuration
AUTHELIA_ENABLED=false
# SECURITY (SEC-04): When enabling Authelia, ensure the app port is NOT
# directly reachable from the internet. Only the Caddy proxy should reach it.
# AUTHELIA_LOGIN_URL=https://auth.example.com
# AUTHELIA_LOGOUT_URL=https://auth.example.com/logout

# Google OAuth
# REQUIRED if using Google Login. Get from console.cloud.google.com
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# CORS — comma-separated allowed origins (defaults to localhost:3000 if unset)
# ALLOWED_ORIGINS=https://your-domain.com
